{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "规则参数（数值表第 0、3、4 节及 1.3–1.6 节的规则部分）",
  "description": "每个 rules/*.json 用 kind 字段声明自己的类型，按 kind 套用对应定义",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "enum": ["conventions", "accuracy", "damage", "intercept", "exposure", "emission", "debris", "tracks", "ew", "positions", "support", "economy", "movement", "terrain", "engagement", "civil", "enemy_ai", "commands", "campaign_rules"] }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "conventions" } } },    "then": { "$ref": "#/$defs/conventions" } },
    { "if": { "properties": { "kind": { "const": "accuracy" } } },       "then": { "$ref": "#/$defs/accuracy" } },
    { "if": { "properties": { "kind": { "const": "damage" } } },         "then": { "$ref": "#/$defs/damage" } },
    { "if": { "properties": { "kind": { "const": "intercept" } } },      "then": { "$ref": "#/$defs/intercept" } },
    { "if": { "properties": { "kind": { "const": "exposure" } } },       "then": { "$ref": "#/$defs/exposure" } },
    { "if": { "properties": { "kind": { "const": "emission" } } },       "then": { "$ref": "#/$defs/emission" } },
    { "if": { "properties": { "kind": { "const": "debris" } } },         "then": { "$ref": "#/$defs/debris" } },
    { "if": { "properties": { "kind": { "const": "tracks" } } },         "then": { "$ref": "#/$defs/tracks" } },
    { "if": { "properties": { "kind": { "const": "ew" } } },             "then": { "$ref": "#/$defs/ew" } },
    { "if": { "properties": { "kind": { "const": "positions" } } },      "then": { "$ref": "#/$defs/positions" } },
    { "if": { "properties": { "kind": { "const": "support" } } },        "then": { "$ref": "#/$defs/support" } },
    { "if": { "properties": { "kind": { "const": "economy" } } },        "then": { "$ref": "#/$defs/economy" } },
    { "if": { "properties": { "kind": { "const": "movement" } } },       "then": { "$ref": "#/$defs/movement" } },
    { "if": { "properties": { "kind": { "const": "terrain" } } },        "then": { "$ref": "#/$defs/terrain" } },
    { "if": { "properties": { "kind": { "const": "engagement" } } },     "then": { "$ref": "#/$defs/engagement" } },
    { "if": { "properties": { "kind": { "const": "civil" } } },          "then": { "$ref": "#/$defs/civil" } },
    { "if": { "properties": { "kind": { "const": "enemy_ai" } } },       "then": { "$ref": "#/$defs/enemy_ai" } },
    { "if": { "properties": { "kind": { "const": "commands" } } },       "then": { "$ref": "#/$defs/commands" } },
    { "if": { "properties": { "kind": { "const": "campaign_rules" } } }, "then": { "$ref": "#/$defs/campaign_rules" } }
  ],
  "$defs": {
    "prob": { "$ref": "common.schema.json#/$defs/probability" },
    "mult": { "type": "number", "minimum": 0 },

    "conventions": {
      "type": "object",
      "required": ["gameSecToWorldSec", "worldStepSec", "cellKm", "machKmh", "currency"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "gameSecToWorldSec": { "type": "number", "exclusiveMinimum": 0 },
        "worldStepSec": { "type": "number", "exclusiveMinimum": 0 },
        "cellKm": { "type": "number", "exclusiveMinimum": 0 },
        "machKmh": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "const": "Musd" }
      },
      "additionalProperties": false
    },

    "accuracy": {
      "type": "object",
      "required": ["tierOrder", "tiers", "spotterTierBoost"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "tierOrder": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/accuracyTier" }, "minItems": 4, "maxItems": 4, "uniqueItems": true, "description": "从差到好" },
        "tiers": {
          "type": "object",
          "required": ["A", "B", "C", "D"],
          "additionalProperties": {
            "type": "object",
            "required": ["offsetCells", "ewExtraCells"],
            "properties": {
              "offsetCells": { "$ref": "common.schema.json#/$defs/minMax" },
              "ewExtraCells": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "spotterTierBoost": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "damage": {
      "type": "object",
      "required": ["bands", "splashFalloff", "unitFootprintCells", "componentRadarChance"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "bands": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["minLevel", "maxLevel", "airDefense", "civilBuildings", "gridDamagePct"],
            "properties": {
              "minLevel": { "type": "integer", "minimum": 0, "maximum": 10 },
              "maxLevel": { "type": "integer", "minimum": 0, "maximum": 10 },
              "airDefense": {
                "type": "object",
                "required": ["effect"],
                "properties": {
                  "effect": { "enum": ["light_damage", "heavy_damage", "destroy_component", "destroy_fire_unit", "destroy_fire_unit_and_adjacent"] },
                  "efficiencyMult": { "$ref": "#/$defs/mult" },
                  "repairable": { "type": "boolean" },
                  "suspendGameSec": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "civilBuildings": {
                "type": "object",
                "required": ["effect"],
                "properties": {
                  "effect": { "enum": ["minor", "buildings", "block"] },
                  "destroyed": { "$ref": "common.schema.json#/$defs/minMax" }
                },
                "additionalProperties": false
              },
              "gridDamagePct": { "type": "number", "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          }
        },
        "splashFalloff": {
          "type": "object",
          "required": ["center", "edge", "curve"],
          "properties": {
            "center": { "$ref": "#/$defs/mult" },
            "edge": { "$ref": "#/$defs/mult" },
            "curve": { "const": "linear" }
          },
          "additionalProperties": false
        },
        "unitFootprintCells": { "type": "number", "exclusiveMinimum": 0 },
        "componentRadarChance": { "$ref": "#/$defs/prob" }
      },
      "additionalProperties": false
    },

    "intercept": {
      "type": "object",
      "required": ["decoyUsesColumn", "classes", "modifiers"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "decoyUsesColumn": { "$ref": "common.schema.json#/$defs/targetTag" },
        "classes": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "$ref": "common.schema.json#/$defs/targetTag" },
            "additionalProperties": {
              "oneOf": [
                { "$ref": "#/$defs/prob" },
                {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "required": ["from", "value"],
                    "properties": { "from": { "$ref": "common.schema.json#/$defs/yearMonth" }, "value": { "$ref": "#/$defs/prob" } },
                    "additionalProperties": false
                  }
                }
              ]
            }
          },
          "description": "拦截概率类别 → 目标标签 → 单发基础概率（或随时期变化的数组）。缺失 = 该类别不能拦截该目标"
        },
        "modifiers": {
          "type": "object",
          "required": ["trackVague", "trackApproximateCued", "noCueSelfSearch", "newPositionFirstNight", "crewFatigue", "aceCrew", "restrictedEngagement", "interceptorDroneInFriendlyEw", "evasiveTargetVsInterceptorDrone"],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "probMult": { "$ref": "#/$defs/mult" },
              "gunProbMult": { "$ref": "#/$defs/mult" },
              "missilesAllowed": { "type": "boolean" },
              "firstShotReactionTimeMult": { "$ref": "#/$defs/mult" },
              "reactionTimeMult": { "$ref": "#/$defs/mult" },
              "minConsecutiveNights": { "type": "integer", "minimum": 1 },
              "from": { "$ref": "common.schema.json#/$defs/yearMonth" },
              "enemies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "exposure": {
      "type": "object",
      "required": ["min", "max", "ratesPerGameSec", "perMissileLaunched", "enemyReconRadiusKm", "onRelocate", "sensorExposureLevelRatesPerGameSec", "ewExposureLevelRatesPerGameSec", "thresholds"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "ratesPerGameSec": {
          "type": "object",
          "required": ["fireControlSelfSearch", "fireControlCued", "silent", "enemyReconNearby"],
          "additionalProperties": { "type": "number" }
        },
        "perMissileLaunched": { "type": "number", "minimum": 0 },
        "enemyReconRadiusKm": { "type": "number", "exclusiveMinimum": 0 },
        "onRelocate": {
          "type": "object",
          "required": ["resetTo", "toScoutedPositionMult"],
          "properties": { "resetTo": { "type": "number" }, "toScoutedPositionMult": { "$ref": "#/$defs/mult" } },
          "additionalProperties": false
        },
        "sensorExposureLevelRatesPerGameSec": {
          "type": "object", "required": ["high", "medium", "zero", "none"],
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "ewExposureLevelRatesPerGameSec": {
          "type": "object", "required": ["high", "medium", "low"],
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "object", "required": ["atLeast", "consequence"],
            "properties": {
              "atLeast": { "type": "number" },
              "consequence": { "enum": ["anti_radiation_priority_tonight", "known_target_list_next_night", "precision_strike_tonight"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "emission": {
      "type": "object",
      "required": ["defaultStrategy", "dutyCycleDefaultOnGameSec", "dutyCycleDefaultOffGameSec", "decoyLeadGameSec", "defaultReferenceRangeKm", "strategies", "triggers", "shutdownTiming"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "defaultStrategy": { "$ref": "common.schema.json#/$defs/id" },
        "dutyCycleDefaultOnGameSec": { "type": "number", "exclusiveMinimum": 0 },
        "dutyCycleDefaultOffGameSec": { "type": "number", "exclusiveMinimum": 0 },
        "decoyLeadGameSec": { "type": "number", "exclusiveMinimum": 0 },
        "defaultReferenceRangeKm": { "type": "number", "exclusiveMinimum": 0 },
        "strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nameKey", "activation", "exposureMult", "reactionTimeMult"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "nameKey": { "$ref": "common.schema.json#/$defs/locKey" },
              "activation": { "enum": ["always", "approximate_warning", "duty_cycle", "last_moment", "after_decoy"] },
              "exposureMult": { "$ref": "#/$defs/mult" },
              "reactionTimeMult": { "$ref": "#/$defs/mult" },
              "trackInterrupted": { "type": "boolean" },
              "configurableOnOff": { "type": "boolean" },
              "canRelocate": { "type": "boolean" },
              "requires": { "type": "array", "items": { "enum": ["approximate_track", "network", "decoy"] } },
              "availableFromLevel": { "$ref": "common.schema.json#/$defs/levelNumber" },
              "westernSystemsOnly": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "triggers": {
          "type": "object",
          "required": ["onAntiRadiationIncoming", "afterFiring", "onMainRadarDestroyed"],
          "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "shutdownTiming": {
          "type": "array",
          "items": {
            "type": "object", "required": ["armDistanceFractionAbove", "armHitProbMult"],
            "properties": {
              "armDistanceFractionAbove": { "type": "number", "minimum": 0, "maximum": 1 },
              "armHitProbMult": { "$ref": "#/$defs/mult" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "debris": {
      "type": "object",
      "required": ["urbanInterceptDamageFraction", "urbanInterceptRadiusCells", "ruralInterceptDamageFraction", "divertedImpactFullDamageInUrban", "scoreUrbanInterceptRatio"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "urbanInterceptDamageFraction": { "$ref": "#/$defs/prob" },
        "urbanInterceptRadiusCells": { "type": "number", "minimum": 0 },
        "ruralInterceptDamageFraction": { "$ref": "#/$defs/prob" },
        "divertedImpactFullDamageInUrban": { "type": "boolean" },
        "scoreUrbanInterceptRatio": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "trackQualityId": { "enum": ["vague", "approximate", "precise"] },
    "tracks": {
      "type": "object",
      "required": ["qualities", "approximateFromLocalSensorCount", "cueing", "warningRadarEnemyAiWeightAs", "bLine", "detectionRules"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "qualities": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "decoyDiscrimination", "missilesAllowed", "display", "actions"],
            "properties": {
              "id": { "$ref": "#/$defs/trackQualityId" },
              "decoyDiscrimination": { "$ref": "#/$defs/prob" },
              "missilesAllowed": { "type": "boolean" },
              "display": { "enum": ["area_and_arrow", "icon_and_error_circle", "precise_icon"] },
              "actions": { "type": "array", "uniqueItems": true, "items": { "enum": ["pre_position", "raise_alert", "vector_fighters", "vector_fire_teams", "vector_interceptor_drones", "cue_fire_control", "launch_missile"] } }
            },
            "additionalProperties": false
          }
        },
        "approximateFromLocalSensorCount": { "type": "integer", "minimum": 1 },
        "cueing": {
          "type": "object",
          "required": ["cued", "uncued"],
          "properties": {
            "cued": {
              "type": "object", "required": ["minTrackQuality", "fireControlOnlyLastReactionTime", "exposureMult"],
              "properties": {
                "minTrackQuality": { "$ref": "#/$defs/trackQualityId" },
                "fireControlOnlyLastReactionTime": { "type": "boolean" },
                "exposureMult": { "$ref": "#/$defs/mult" }
              },
              "additionalProperties": false
            },
            "uncued": {
              "type": "object", "required": ["exposureMult", "firstShotReactionTimeMult"],
              "properties": {
                "exposureMult": { "$ref": "#/$defs/mult" },
                "firstShotReactionTimeMult": { "$ref": "#/$defs/mult" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "warningRadarEnemyAiWeightAs": { "type": "string" },
        "bLine": {
          "type": "object", "required": ["regionalRadarDirectControl", "relayDelayGameSec", "maxTrackQuality"],
          "properties": {
            "regionalRadarDirectControl": { "type": "boolean" },
            "relayDelayGameSec": { "type": "number", "minimum": 0 },
            "maxTrackQuality": { "$ref": "#/$defs/trackQualityId" }
          },
          "additionalProperties": false
        },
        "detectionRules": {
          "type": "object",
          "required": ["lowAltitudeBelowM", "lowAltitudeRangeMult", "largeBlindZoneLowAltitudeRangeMult", "coverageLowAltitudeMinCapability", "closeRangeFraction", "errorRadiusM", "fastUpdateErrorRadiusMult", "trackLostGameSec", "falseAlarmsPerGameSec", "reportDelayGameSec", "opticalWeatherRangeMult", "opticalNightRangeMult", "opticalSearchlightRangeMult", "unpoweredActiveRangeMult", "winterActiveRangeMult"],
          "properties": {
            "lowAltitudeBelowM": { "type": "number", "minimum": 0 },
            "lowAltitudeRangeMult": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mult" } },
            "largeBlindZoneLowAltitudeRangeMult": { "$ref": "#/$defs/mult" },
            "coverageLowAltitudeMinCapability": { "type": "string" },
            "closeRangeFraction": { "$ref": "#/$defs/prob" },
            "errorRadiusM": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
            "fastUpdateErrorRadiusMult": { "$ref": "#/$defs/mult" },
            "trackLostGameSec": { "type": "number", "minimum": 0 },
            "falseAlarmsPerGameSec": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
            "reportDelayGameSec": { "type": "number", "minimum": 0 },
            "opticalWeatherRangeMult": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mult" } },
            "opticalNightRangeMult": { "$ref": "#/$defs/mult" },
            "opticalSearchlightRangeMult": { "$ref": "#/$defs/mult" },
            "unpoweredActiveRangeMult": { "$ref": "#/$defs/mult" },
            "winterActiveRangeMult": { "$ref": "#/$defs/mult" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "ew": {
      "type": "object",
      "required": ["effectivenessByPeriod", "sideEffects", "linkCutOutcomeWeights", "hoverBeforeCrashGameSec", "belowFullStrengthMult", "unpoweredEffectMult", "winterEffectMult", "urbanNavJamMinGameSec"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "effectivenessByPeriod": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["from", "nav", "counterUas"],
            "properties": {
              "from": { "$ref": "common.schema.json#/$defs/yearMonth" },
              "nav": { "$ref": "#/$defs/prob" },
              "counterUas": { "$ref": "#/$defs/prob" },
              "navTerminalIneffectiveVsAiVision": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "sideEffects": {
          "type": "object", "required": ["ownDroneLinkCut", "urbanNavJamCityResiliencePerNight"],
          "properties": {
            "ownDroneLinkCut": { "type": "boolean" },
            "urbanNavJamCityResiliencePerNight": { "type": "number" }
          },
          "additionalProperties": false
        },
        "linkCutOutcomeWeights": {
          "type": "object", "required": ["crash", "hover", "return"],
          "properties": {
            "crash": { "$ref": "#/$defs/prob" },
            "hover": { "$ref": "#/$defs/prob" },
            "return": { "$ref": "#/$defs/prob" }
          },
          "additionalProperties": false
        },
        "hoverBeforeCrashGameSec": { "type": "number", "minimum": 0 },
        "belowFullStrengthMult": { "$ref": "#/$defs/mult" },
        "unpoweredEffectMult": { "$ref": "#/$defs/mult" },
        "winterEffectMult": { "$ref": "#/$defs/mult" },
        "urbanNavJamMinGameSec": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "positions": {
      "type": "object",
      "required": ["preparedAlternate", "newUnsurveyed", "deception"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "preparedAlternate": {
          "type": "object", "required": ["deployTimeMult", "firstNightPenalty", "cost", "persistsForLevel", "availableFromLevel"],
          "properties": {
            "deployTimeMult": { "$ref": "#/$defs/mult" },
            "firstNightPenalty": { "type": "boolean" },
            "cost": { "const": "time_slot" },
            "persistsForLevel": { "type": "boolean" },
            "availableFromLevel": { "$ref": "common.schema.json#/$defs/levelNumber" }
          },
          "additionalProperties": false
        },
        "newUnsurveyed": {
          "type": "object", "required": ["firstNightEfficiencyMult"],
          "properties": { "firstNightEfficiencyMult": { "$ref": "#/$defs/mult" } },
          "additionalProperties": false
        },
        "deception": {
          "type": "object",
          "required": ["fakeLauncherSeeThroughChance", "decoyEmitterExposureLevel"],
          "properties": {
            "fakeLauncherSeeThroughChance": {
              "type": "object", "required": ["low", "medium", "high"],
              "additionalProperties": { "$ref": "#/$defs/prob" }
            },
            "decoyEmitterExposureLevel": { "enum": ["high", "medium", "zero", "none"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "support": {
      "type": "object",
      "required": ["fighterSortiesPerNight", "bigRaidRefusalChance", "frontlineRiskZoneBlocksCalls", "airspace"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "fighterSortiesPerNight": { "$ref": "common.schema.json#/$defs/minMax" },
        "bigRaidRefusalChance": { "$ref": "#/$defs/prob" },
        "frontlineRiskZoneBlocksCalls": { "type": "boolean" },
        "airspace": {
          "type": "object", "required": ["restrictedEngagement", "fighterExclusiveZone"],
          "properties": {
            "restrictedEngagement": {
              "type": "object", "required": ["isDefault", "confirmedHostileOnly", "reactionTimeMult"],
              "properties": { "isDefault": { "type": "boolean" }, "confirmedHostileOnly": { "type": "boolean" }, "reactionTimeMult": { "$ref": "#/$defs/mult" } },
              "additionalProperties": false
            },
            "fighterExclusiveZone": {
              "type": "object", "required": ["isDefault", "groundHoldFire"],
              "properties": { "isDefault": { "type": "boolean" }, "groundHoldFire": { "type": "boolean" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "economy": {
      "type": "object",
      "required": ["exchangeRatio", "ammoTiers", "historicalEvents", "commandPointsPerNight", "trust", "crossLevelModClamp", "cityResource", "supply", "repair", "relocation", "emergencySupport", "requests"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "exchangeRatio": {
          "type": "object", "required": ["numerator", "denominator"],
          "properties": { "numerator": { "type": "string" }, "denominator": { "type": "string" } },
          "additionalProperties": false
        },
        "ammoTiers": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "replenish"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "weapons": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
              "replenish": { "oneOf": [{ "const": false }, { "const": "supply_window" }] },
              "sharedBy": { "enum": ["line_a", "line_b"] },
              "hasFloor": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "historicalEvents": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "effect"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "from": { "$ref": "common.schema.json#/$defs/yearMonth" },
              "until": { "$ref": "common.schema.json#/$defs/yearMonth" },
              "effect": { "enum": ["unit_unavailable", "resupply_mult"] },
              "unit": { "$ref": "common.schema.json#/$defs/id" },
              "weapon": { "$ref": "common.schema.json#/$defs/id" },
              "mult": { "$ref": "#/$defs/mult" }
            },
            "additionalProperties": false
          }
        },
        "commandPointsPerNight": { "$ref": "common.schema.json#/$defs/minMax" },
        "trust": { "type": "object" },
        "crossLevelModClamp": { "type": "object" },
        "cityResource": { "type": "object" },
        "supply": { "type": "object" },
        "repair": { "type": "object" },
        "relocation": { "type": "object" },
        "emergencySupport": { "type": "object" },
        "requests": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },

    "movement": {
      "type": "object",
      "required": ["altitudeBandsM", "cruiseDescentAngleDeg", "highDiveAngleDeg", "ballisticTerminalAngleDeg", "quasiBallisticTerminalAngleDeg", "diveSpeedMult"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "altitudeBandsM": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/minMax" } },
        "cruiseDescentAngleDeg": { "type": "number", "exclusiveMinimum": 0 },
        "highDiveAngleDeg": { "type": "number", "exclusiveMinimum": 0 },
        "ballisticTerminalAngleDeg": { "type": "number", "exclusiveMinimum": 0 },
        "quasiBallisticTerminalAngleDeg": { "type": "number", "exclusiveMinimum": 0 },
        "diveSpeedMult": { "$ref": "#/$defs/mult" }
      },
      "additionalProperties": false
    },

    "terrain": {
      "type": "object",
      "required": ["losSampleStepPx", "earthRadiusM", "refractionK", "defaultAntennaHeightM", "horizonAzimuthBins"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "losSampleStepPx": { "type": "number", "exclusiveMinimum": 0 },
        "earthRadiusM": { "type": "number", "exclusiveMinimum": 0 },
        "refractionK": { "type": "number", "exclusiveMinimum": 0 },
        "defaultAntennaHeightM": { "type": "number", "minimum": 0 },
        "horizonAzimuthBins": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },

    "engagement": {
      "type": "object",
      "required": ["byWeaponKind", "reactionGameSecByClass", "barrelCooldown", "defaultLaunchers", "maxSalvoSize", "allocation", "defaultRule", "defaultRuleByTag", "fighterRule"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "byWeaponKind": { "type": "object" },
        "reactionGameSecByClass": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "barrelCooldown": { "type": "object" },
        "defaultLaunchers": { "type": "integer", "minimum": 1 },
        "maxSalvoSize": { "type": "integer", "minimum": 1 },
        "allocation": { "type": "string" },
        "defaultRule": { "type": "object" },
        "defaultRuleByTag": { "type": "object" },
        "fighterRule": { "type": "object" }
      },
      "additionalProperties": false
    },

    "civil": {
      "type": "object",
      "required": ["grid", "alert", "scoring"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "grid": { "type": "object" },
        "alert": { "type": "object" },
        "scoring": { "type": "object" }
      },
      "additionalProperties": false
    },

    "enemy_ai": {
      "type": "object",
      "required": ["knownTargets", "exposure100", "probe", "suppress", "saturate", "bypass"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "knownTargets": { "type": "object" },
        "exposure100": { "type": "object" },
        "probe": { "type": "object" },
        "suppress": { "type": "object" },
        "saturate": { "type": "object" },
        "bypass": { "type": "object" }
      },
      "additionalProperties": false
    },

    "commands": {
      "type": "object",
      "required": ["commandPointCosts", "moveUnitTiers", "relocateUnitTiers", "armChoice", "maxOpenAutoChoices", "storyChoice"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "commandPointCosts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "moveUnitTiers": { "type": "array", "items": { "type": "string" } },
        "relocateUnitTiers": { "type": "array", "items": { "type": "string" } },
        "armChoice": { "type": "object" },
        "maxOpenAutoChoices": { "type": "integer", "minimum": 1 },
        "storyChoice": { "type": "object" }
      },
      "additionalProperties": false
    },

    "campaign_rules": {
      "type": "object",
      "required": ["crew", "alert", "autoResolve", "adaptation", "dossier", "cityMemory", "rewardCards", "balanceTargets"],
      "properties": {
        "$schema": true, "kind": true, "_source": { "$ref": "common.schema.json#/$defs/source" }, "provisional": { "$ref": "common.schema.json#/$defs/provisional" },
        "crew": { "type": "object" },
        "alert": { "type": "object" },
        "autoResolve": { "type": "object" },
        "adaptation": { "type": "object" },
        "dossier": { "type": "object" },
        "cityMemory": { "type": "object" },
        "rewardCards": { "type": "object" },
        "balanceTargets": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
