# 文本统一 LF
* text=auto eol=lf
*.cs     text diff=csharp
*.json   text
*.md     text
*.tscn   text
*.tres   text
*.gd     text
*.py     text
*.sh     text eol=lf

# 美术源文件 → Git LFS
art_src/**/*.blend  filter=lfs diff=lfs merge=lfs -text
art_src/**/*.fbx    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.obj    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.glb    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.psd    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.kra    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.exr    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.png    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.jpg    filter=lfs diff=lfs merge=lfs -text
art_src/**/*.tif    filter=lfs diff=lfs merge=lfs -text

# 游戏内大文件 → Git LFS
game/**/*.wav       filter=lfs diff=lfs merge=lfs -text
game/**/*.ogg       filter=lfs diff=lfs merge=lfs -text
game/**/*.mp3       filter=lfs diff=lfs merge=lfs -text
game/**/*.ttf       filter=lfs diff=lfs merge=lfs -text
game/**/*.otf       filter=lfs diff=lfs merge=lfs -text

# 高程图（16 位 PNG）→ Git LFS
data/levels/**/heightmap.png filter=lfs diff=lfs merge=lfs -text
